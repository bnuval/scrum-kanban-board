generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum IssueType {
  EPIC
  FEATURE
  STORY
  TASK
  BUG
}

enum IssuePriority {
  LOWEST
  LOW
  MEDIUM
  HIGH
  HIGHEST
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum ProjectRole {
  ADMIN
  MEMBER
  VIEWER
}

enum LinkType {
  RELATES_TO
  BLOCKS
  IS_BLOCKED_BY
  DUPLICATES
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  name           String?
  avatarUrl      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  assignedIssues Issue[]         @relation("IssueAssignee")
  reportedIssues Issue[]         @relation("IssueReporter")
  comments       Comment[]
  memberships    ProjectMember[]
}

model Project {
  id          String          @id @default(uuid())
  key         String          @unique
  name        String
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  columns     Column[]
  sprints     Sprint[]
  issues      Issue[]
  members     ProjectMember[]
}

model ProjectMember {
  id        String      @id @default(uuid())
  role      ProjectRole @default(MEMBER)
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Column {
  id        String   @id @default(uuid())
  name      String
  order     Int
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    Issue[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
}

model Sprint {
  id        String       @id @default(uuid())
  name      String
  status    SprintStatus @default(PLANNED)
  startDate DateTime?
  endDate   DateTime?
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    Issue[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Issue {
  id          String        @id @default(uuid())
  number      Int           @default(autoincrement())
  key         String        @unique
  title       String
  description String?
  type        IssueType     @default(TASK)
  priority    IssuePriority @default(MEDIUM)
  order       Float
  storyPoints Int?
  isCompleted Boolean       @default(false)

  parentId    String?
  parent      Issue?        @relation("Hierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Issue[]       @relation("Hierarchy")

  outgoingLinks IssueLink[] @relation("SourceLinks")
  incomingLinks IssueLink[] @relation("TargetLinks")

  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  columnId    String
  column      Column        @relation(fields: [columnId], references: [id], onDelete: Cascade)

  sprintId    String?
  sprint      Sprint?       @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  assigneeId  String?
  assignee    User?         @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  reporterId  String?
  reporter    User?         @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  comments    Comment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model IssueLink {
  id        String   @id @default(uuid())
  type      LinkType @default(RELATES_TO)
  sourceId  String
  source    Issue    @relation("SourceLinks", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId  String
  target    Issue    @relation("TargetLinks", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([sourceId, targetId, type])
}

model Comment {
  id        String   @id @default(uuid())
  body      String
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}